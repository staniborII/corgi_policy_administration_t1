# =============================================================================
# Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# DB_TYPE controls which database backend Django uses.
#   "sqlite"   → SQLite (default, no setup required for local dev)
#   "postgres"  → PostgreSQL (for integration testing and production)
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite):
DB_NAME=db.sqlite3

# PostgreSQL settings (used when DB_TYPE=postgres):
# DB_NAME=corgi_dev
# DB_USER=corgi_user
# DB_PASSWORD=corgi_pass
# DB_HOST=localhost
# DB_PORT=5432
#
# Alternatively, DATABASE_URL overrides everything above if set:
# DATABASE_URL=postgres://corgi_user:corgi_pass@localhost:5432/corgi_dev

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Stripe (test mode) ---
# Leave blank to use SIMULATED mode (no Stripe account needed for development).
STRIPE_PUBLISHABLE_KEY=pk_test_51UDdimC7UK2XKCderfUhGpBwYqTRewwnIMFK3aNdMceTkmbJ7nZ9oRvWMCoS38kIBaF7mtUiMizF9s2c19Rycv3900RLcoPB5v
STRIPE_SECRET_KEY=sk_test_51UDdimC7UK2XKCdeRl8igMI9Npjy1krKG4Z3DtwJsn9LDOv5xCUFGUNYqfByoGtfgtDeRIUJtz5peOmHV3XzqOog00x0fGmwgl
STRIPE_WEBHOOK_SECRET=

# --- Persona (sandbox) ---
# Leave blank to use SIMULATED mode (no Persona account needed for development).
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=
PERSONA_API_BASE=https://withpersona.com/api/v1


# --- Superuser (used by `manage.py ensure_superuser`) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=adminpass
